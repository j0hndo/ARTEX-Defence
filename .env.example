# The demo is reachable only on 127.0.0.1:18091.
# List only the site hostnames that may serve the synthetic canary path.
CANARY_ALLOWED_HOSTS=127.0.0.1,localhost
CANARY_TTL_SECONDS=900
CANARY_MAX_ACTIVE_RUNS=1024
# observe emits a sanitized canary_match event without denying the request.
# deny_verify returns 403 for a valid decoy verify request after logging it.
CANARY_POLICY=observe
# Optional. Set only the CIDR of a proxy that generates X-Canary-Request-ID.
# Leave empty when the proxy address is not controlled and verified.
CANARY_TRUSTED_PROXY_CIDRS=
