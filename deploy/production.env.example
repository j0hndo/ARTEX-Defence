# Copy this file to deploy/production.env and set the actual public app hostname.
# A blank value prevents Compose from starting the sidecar.
CANARY_ALLOWED_HOSTS=

# Start with observation. deny_verify returns 403 only for a valid decoy verify.
CANARY_POLICY=observe
CANARY_TTL_SECONDS=300
CANARY_MAX_ACTIVE_RUNS=1024

# Optional. Leave blank until the gateway is the only process that can reach
# the sidecar. Host loopback publishing alone does not prove this: another local
# process may appear to the container as the same bridge peer as host Nginx.
# Only then set the direct Nginx peer IP or narrow CIDR. A request_id is
# investigative correlation data, never enough for automatic session action.
CANARY_TRUSTED_PROXY_CIDRS=
